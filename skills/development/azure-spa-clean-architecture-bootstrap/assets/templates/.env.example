NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=__PUBLIC_APP_URL__
SESSION_SECRET=__SESSION_SECRET__

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=__PUBLIC_APP_URL__/auth/github/callback

DATABASE_URL=sqlserver://__SQL_SERVER_HOST__:1433;database=__SQL_DATABASE_NAME__;encrypt=true;trustServerCertificate=false;authentication=ActiveDirectoryDefault
PRISMA_DATABASE_URL=${DATABASE_URL}
SQLSERVER_AUTH_MODE=default-azure-credential

AZURE_CLIENT_ID=
AZURE_TENANT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=
